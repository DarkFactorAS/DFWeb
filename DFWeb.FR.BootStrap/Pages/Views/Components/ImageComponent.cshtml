@using DFWeb.BE.Models
@model TeaserPageContentModel

<div class="article" style="width:100%">

    @if ( Model.ImageId != 0 )
    {
        @* Show Image if we have data *@    
        <div>
            <center><a href="/page?id=@Model.PageId"><img width="100%" height="100%" src="/api/Image/GetImage?imageId=@Model.ImageId" alt=""></a></center>
        </div>

        @if ( Model.IsEdit )
        {
            <div class="article" style="width:100%;padding:10px;">
                <form  method='POST' action="/api/Image/DeleteImage" style='display: inline;'>
                    <input type='hidden' name='pageId' value='@Model.PageId'>
                    <input type='hidden' name='imageId' value='@Model.ImageId'>
                    <button type='submit' class="btn btn-primary btn-sm"><i class="fas fa-trash-alt me-1"></i>Remove Image</button>
                </form>
                <form  method='GET' action="/Editor/ImageSelector" style='display: inline;'>
                    <input type='hidden' name='pageId' value='@Model.PageId'>
                    <button type='submit' class="btn btn-primary btn-sm"><i class="fas fa-image me-1"></i>Select Image</button>
                </form>
            </div>
        }
    }

    @* Show Add button to upload new image *@    
    @if (Model.IsEdit)
    {
        <div class="article" style="width:100%;padding:10px;align:center">
            @if ( Model.ImageId == 0 )
            {
                <form  method='GET' action="/Editor/ImageSelector" style='display: inline;'>
                    <input type='hidden' name='pageId' value='@Model.PageId'>
                    <button type='submit' class="btn btn-primary btn-sm"><i class="fas fa-image me-1"></i>Select Image</button>
                </form>
            }
        </div>
    }

</div>
