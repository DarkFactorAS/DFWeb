{
    "AppName": "DFWeb",
    "IsConfigEncrypted": "CONFIG.ISENCRYPTED",
    "DatabaseConnection": {
        "Server": "DATABASE.SERVER",
        "Port": "DATABASE.PORT",
        "Database": "DATABASE.NAME",
        "Username": "DATABASE.USERNAME",
        "Password": "DATABASE.PASSWORD",
        "SSLMode" : "DATABASE.SSLMODE"
    },
    "EnableLogging": true,
    "reloadOnChange": false,
    "AccountServer": {
        "Endpoint": "ACCOUNTSERVER.URL",
        "ClientId": "ACCOUNTSERVER.CLIENTID",
        "ClientSecret": "ACCOUNTSERVER.CLIENTSECRET",
        "Scope" : "ACCOUNTSERVER.SCOPE"
    }
}